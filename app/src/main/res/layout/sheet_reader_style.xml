<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_xl"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_xxl">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reader_style"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/reader_text_size"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body_sm" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/style_font_minus"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/reader_font_smaller"
            android:text="@string/reader_font_minus_glyph" />

        <TextView
            android:id="@+id/style_font_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/style_font_plus"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/reader_font_bigger"
            android:text="@string/reader_font_plus_glyph" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/reader_font_family"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body_sm" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/style_font_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/style_font_serif"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/reader_font_serif" />

        <com.google.android.material.chip.Chip
            android:id="@+id/style_font_sans"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/reader_font_sans" />

        <com.google.android.material.chip.Chip
            android:id="@+id/style_font_mono"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/reader_font_mono" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/reader_theme"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body_sm" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/style_theme_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleLine="false"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/style_theme_paper"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/reader_theme_paper" />

        <com.google.android.material.chip.Chip
            android:id="@+id/style_theme_sepia"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/reader_theme_sepia" />

        <com.google.android.material.chip.Chip
            android:id="@+id/style_theme_night"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/reader_theme_night" />

        <com.google.android.material.chip.Chip
            android:id="@+id/style_theme_black"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/reader_theme_black" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/reader_mode"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body_sm" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/style_mode_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleLine="false"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/style_mode_paged"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/reader_mode_paged" />

        <com.google.android.material.chip.Chip
            android:id="@+id/style_mode_scroll"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/reader_mode_scroll" />
    </com.google.android.material.chip.ChipGroup>

</LinearLayout>
