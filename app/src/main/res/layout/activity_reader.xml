<?xml version="1.0" encoding="utf-8"?>
<!--
  Built-in reader: a WebView renders the imported FB2/TXT, the top bar holds
  the honest timer and typography controls, the bottom bar ends the session.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/reader_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/reader_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Мартин Иден" />

        <TextView
            android:id="@+id/reader_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/accent_primary_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="12:34" />

        <TextView
            android:id="@+id/reader_theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reader_theme"
            android:padding="8dp"
            android:text="🌓"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/reader_font"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reader_font_family"
            android:fontFamily="serif"
            android:padding="8dp"
            android:text="@string/reader_font_glyph"
            android:textColor="@color/text_secondary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reader_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reader_mode"
            android:padding="8dp"
            android:text="⇄"
            android:textColor="@color/text_secondary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reader_font_minus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reader_font_smaller"
            android:padding="8dp"
            android:text="A-"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reader_font_plus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reader_font_bigger"
            android:padding="8dp"
            android:text="A+"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reader_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reader_close"
            android:padding="8dp"
            android:text="✕"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/reader_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="@color/accent_primary"
        tools:progress="35" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/reader_web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/reader_light_bg" />

        <TextView
            android:id="@+id/reader_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="serif"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone"
            tools:text="Открываю книгу…"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/reader_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/reader_percent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_hint"
            android:textSize="13sp"
            tools:text="35% · стр. 120 из 340" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reader_finish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reader_finish"
            android:textColor="@color/on_accent"
            app:backgroundTint="@color/accent_primary"
            app:cornerRadius="22dp" />
    </LinearLayout>

</LinearLayout>
