<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen overlay shown by BlockerService when a blocked app is launched
  but the user has no remaining fun time and no emergency tokens.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="serif"
        android:text="📖"
        android:textSize="56sp" />

    <TextView
        android:id="@+id/block_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:textColor="@color/brown"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/block_unlock"
        style="@style/Widget.Book.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/blocked_unlock" />

    <Button
        android:id="@+id/block_spend_token"
        style="@style/Widget.Book.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/blocked_spend_token" />

    <Button
        android:id="@+id/block_exit"
        style="@style/Widget.Book.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/blocked_exit" />

</LinearLayout>
