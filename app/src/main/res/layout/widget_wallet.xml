<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-screen widget: wallet minutes + emergency tokens.
  Plain framework views only — RemoteViews cannot inflate Material widgets.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/overlay_button"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_minutes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/on_accent"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="мин отдыха"
        android:textColor="@color/on_accent"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_tokens"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=" 3"
        android:textColor="@color/on_accent"
        android:textSize="12sp" />
</LinearLayout>
