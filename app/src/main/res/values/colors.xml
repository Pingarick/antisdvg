<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Book brown + page amber.

      The app is a reading room, not a dashboard: warm paper, ink, brass for the
      few things that matter, and no colour that could belong to any SaaS. The
      names below are the ones the whole app already uses, so redefining them
      here re-skins every screen without touching a single layout.
    -->

    <!-- Paper -->
    <color name="background">#F6F1E6</color>
    <color name="off_white">#F6F1E6</color>
    <color name="surface">#FFFCF5</color>
    <color name="on_surface">#221E19</color>

    <!-- Ink -->
    <color name="text_primary">#221E19</color>
    <color name="text_secondary">#6F675C</color>
    <color name="text_hint">#948C7E</color>
    <color name="text_disabled">#B5AC9C</color>

    <!-- Hairline, not shadow -->
    <color name="divider">#E3DACA</color>

    <!-- Book leather, and brass for what earns attention -->
    <color name="accent_primary">#6B4A2A</color>
    <color name="accent_primary_dark">#54381E</color>
    <color name="accent_primary_light">#F0E6D6</color>
    <color name="on_accent">#FFFBF2</color>

    <color name="brass">#C08A3E</color>
    <color name="brass_dark">#A2702C</color>

    <!-- The reader's own themes stay the reader's own -->
    <color name="reader_light_bg">#FFFCF5</color>
    <color name="reader_light_text">#221E19</color>
    <color name="reader_sepia_bg">#F3E9D7</color>
    <color name="reader_sepia_text">#3A3226</color>
    <color name="reader_dark_bg">#1A1815</color>
    <color name="reader_dark_text">#E6DFD3</color>

    <!-- Legacy names the layouts still reference: kept, pointed at the new palette -->
    <color name="cream">#F6F1E6</color>
    <color name="cream_light">#FFFCF5</color>
    <color name="paper">#FFFCF5</color>
    <color name="brown">#6B4A2A</color>
    <color name="brown_dark">#54381E</color>
    <color name="text_dark">#221E19</color>
    <color name="gold">#C08A3E</color>
    <color name="gold_dark">#A2702C</color>
    <color name="gold_pale">#EFE3CE</color>
    <color name="muted_text">#6F675C</color>

    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>

    <!-- Feedback -->
    <color name="success">#4F7A42</color>
    <color name="error">#B3492F</color>
    <color name="error_tint">#18B3492F</color>
    <color name="info">#5B6E86</color>
</resources>
